{
  "name": "@another-earth/world-core",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "imports": {
    "#generation/nature/common": "./src/generation/nature/common/index.ts",
    "#generation/nature/geography": "./src/generation/nature/geography/index.ts",
    "#generation/nature/geology": "./src/generation/nature/geology/index.ts",
    "#generation/pipeline": "./src/generation/pipeline/index.ts",
    "#*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src benchmarks vitest.mesh-perf.config.ts vitest.generation-perf.config.ts vitest.geology-perf.config.ts vitest.terrain-perf.config.ts vitest.climate-perf.config.ts",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests",
    "bench:mesh": "vitest run --config vitest.mesh-perf.config.ts",
    "bench:generation": "vitest run --config vitest.generation-perf.config.ts",
    "bench:geology": "vitest run --config vitest.geology-perf.config.ts",
    "bench:terrain": "vitest run --config vitest.terrain-perf.config.ts",
    "bench:climate": "vitest run --config vitest.climate-perf.config.ts"
  },
  "dependencies": {
    "@another-earth/world-data": "workspace:*",
    "alea": "^1.0.1",
    "delaunator": "^5.1.0",
    "simplex-noise": "4.0.3"
  }
}
