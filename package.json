{
  "name": "another-earth-generator",
  "type": "module",
  "version": "1.4.1",
  "private": true,
  "author": {
    "name": "42arch",
    "email": "rend42@163.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/42arch/another-earth-generator.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build:icons": "npx fantasticon public/icons/maki -o public/fonts -n maki -t woff ttf -g ts json --normalize true && cp public/fonts/maki.ts src/core/rendering/shared/maki.ts",
    "release": "changeset tag && git push --follow-tags"
  },
  "dependencies": {
    "@lucide/svelte": "^1.34.0",
    "alea": "^1.0.1",
    "bits-ui": "^2.19.0",
    "d3-geo": "^3.1.1",
    "d3-geo-voronoi": "^2.1.0",
    "d3-scale-chromatic": "^3.1.0",
    "delaunator": "^5.1.0",
    "fflate": "^0.8.3",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "troika-three-text": "^0.52.5",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@changesets/cli": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/delaunator": "^5.0.3",
    "@types/node": "^25.6.0",
    "@types/three": "^0.185.4",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
