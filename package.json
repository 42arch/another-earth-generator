{
  "name": "another-earth",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --workspaces build",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "bun run --workspaces lint",
    "lint:fix": "bun run --workspaces lint:fix",
    "test": "bun run --workspaces test",
    "changelog": "changelogen --output CHANGELOG.md",
    "release": "bumpp --recursive --all"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@types/node": "^25.6.0",
    "bumpp": "^12.3.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.19.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
